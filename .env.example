# MkBoard Open-Source Local BYOK Environment (Optional)
# You can configure API keys either in the MkBoard Settings -> API Keys UI
# or via environment variables below. Environment variables take precedence.

# Image & Seedance 2.0 Video Provider (KIE AI)
KIE_API_KEY=
# Optional custom KIE API base URL
MKBOARD_KIE_BASE_URL=https://api.kie.ai

# Direct Image Generation Fallbacks (Optional)
OPENAI_API_KEY=
MKBOARD_OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
MKBOARD_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ElevenLabs Voiceover (Optional)
ELEVENLABS_API_KEY=

# Local / LAN / Tailscale Companion Web Server (Optional)
# Modes: off | local-only | network-accessible
MKBOARD_COMPANION_MODE=local-only
MKBOARD_COMPANION_PORT=3780

# Optional Local CLI Agent Binary Overrides
CODEX_BIN=
CLAUDE_BIN=
GEMINI_CLI_BIN=
OPENCODE_BIN=
CURSOR_AGENT_BIN=
KIMI_BIN=

# Optional Release Code Signing (Disabled by default for community builds)
CSC_IDENTITY_AUTO_DISCOVERY=false
