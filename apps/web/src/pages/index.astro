---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocaleFromRequest, localizePath } from "../lib/i18n";
import {
  ChevronDown,
  Download,
  FileText,
  Image as ImageIcon,
  Monitor,
  MonitorDown,
  Table as TableIcon,
} from "lucide-react";

const locale = getLocaleFromRequest(Astro.request, Astro.url);
const windowsAvailable = Boolean(import.meta.env.PUBLIC_WINDOWS_DOWNLOAD_URL);

const copyMap = {
  zh: {
    title: "MkBoard - 自媒体 AI 视频 Agent，拆脚本并生成 B-roll 视频",
    description: "MkBoard 是专属自媒体人的桌面端 AI 视频 Agent，能智能拆出口播、剧情、课程和广告脚本里的 A-roll / B-roll 镜头，并用 Seedance、ChatGPT Image 等模型生成图片和 B-roll 视频素材。",
    keywords: ["自媒体 AI 视频 Agent", "AI B-roll 视频生成", "短视频 B-roll", "AI 分镜 Agent", "视频脚本拆分镜头", "Seedance 视频生成", "ChatGPT Image", "MkBoard"],
    heroAria: "MkBoard 自媒体剪辑 Agent",
    heroBadge: "AI 视频 Agent",
    heroTitle: "专为自媒体而生的分镜制作Agent",
    heroTitleLines: ["专为自媒体而生的", "分镜制作Agent"],
    heroLead: "导入脚本，AI 会理解内容节奏，智能拆出 A-roll / B-roll 镜头，并生成可继续剪辑的视频素材。",
    primaryCta: "下载客户端",
    floatLeft: ["角色参考", "A-ROLL"],
    floatRight: ["画面参考", "B-ROLL"],
    previewAria: "MkBoard macOS 应用界面示意",
    heroImage: "/images/landing/hero-ai-storyboard-video-draft.webp",
    heroImageAlt: "MkBoard 自媒体 AI 视频 Agent 界面，包含脚本、B-roll 分镜卡片和 AI 视频生成时间线",
    previewTitle: "雨夜重逢 · MkBoard",
    problem: {
      aria: "创作痛点",
      badge: "创作卡点",
      title: "视频卡点在哪？",
      body: "从脚本到 B-roll，最难的是把镜头、提示词和素材串起来。",
      items: [
        { title: "脚本缺画面", body: "口播写完了，每段该补什么 B-roll 还要重新想。", image: "/images/landing/problem-long-scripts-icon.svg", imageAlt: "长脚本被拆成 B-roll 镜头卡片的 Notion 风格图标插画" },
        { title: "工具太分散", body: "拆镜头、写提示词、生成视频常常分散在不同工具里。", image: "/images/landing/problem-scattered-assets-icon.svg", imageAlt: "分散的 AI 生成任务被整理进分镜板的 Notion 风格图标插画" },
        { title: "素材难归位", body: "生成结果如果不绑定镜头，剪辑时很难追踪和替换。", image: "/images/landing/problem-slow-feedback-icon.svg", imageAlt: "AI 生成素材回到视频剪辑时间线的 Notion 风格图标插画" }
      ]
    },
