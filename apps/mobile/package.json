{
  "name": "@mkboard/mobile",
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "apk:arm64": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a -Pexpo.useLegacyPackaging=true -Pandroid.enableMinifyInReleaseBuilds=true -Pandroid.enableShrinkResourcesInReleaseBuilds=true --no-daemon",
    "ios:prebuild": "node scripts/build-ios.mjs --prebuild-only",
    "ios:ipa": "node scripts/build-ios.mjs",
    "ios:testflight": "node scripts/build-ios.mjs --upload"
  },
  "private": true
}
